.env.*
*.pem
*.key
*.p12
secrets/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# dependencies (if tooling is ever added)
node_modules/

# site layer runtime data — user store & DB (NEVER commit)
site/data/
*.db
*.db-wal
*.db-shm
*.migrated

# consolidated local secrets/PII export (pre-push sweep) — NEVER commit
private-do-not-commit/
*.crt
*.cert
*.jwk

# local-only design/interview-prep notes — do NOT commit
DESIGN_AND_TRADEOFFS.md

# working agreement for assistant sessions. Local only: it names the private
# interview files and the after-hours push rule, neither of which belongs in a
# public repo. Persistence comes from the file being on disk, not from git.
CLAUDE.md

# local-only personal interview prep — do NOT commit
INTERVIEW_SENIOR_EM_GUIDE.md
ARCHITECTURE_INTERVIEW.md
ARCHITECTURE.md

# one-off history-rewrite helper — local only
purge-history.sh

# separate local repo for roniam.dev architecture designs (its own git repo)
architecture-designs/

# local-only overlay repo for private notes (git private ...) — never commit
.git-local/

# bridge cleanup staging (files the cloud session could not delete)
_to_delete/

# blog drafts stay local until deliberately published — remove this line
# (and blog/ from .git/hooks/pre-push) when a post is ready to go public
blog/

# transient FUSE artifacts from the Cowork device bridge
.fuse_hidden*
**/.fuse_hidden*
dist-site/
*.tgz
