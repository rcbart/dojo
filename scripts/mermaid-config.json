{
  "theme": "neutral",
  "themeVariables": {
    "noteBkgColor": "#f4f1ea",
    "noteTextColor": "#1a1a1a",
    "noteBorderColor": "#c9c3b6",
    "actorBkg": "#f7f7f7",
    "actorBorder": "#8a8a8a",
    "fontSize": "15px",
    "fontFamily": "Arial, 'Liberation Sans', Helvetica, sans-serif"
  },
  "sequence": {
    "wrap": true,
    "width": 230,
    "noteMargin": 8,
    "messageMargin": 40,
    "boxMargin": 12,
    "useMaxWidth": true,
    "actorMargin": 120,
    "wrapPadding": 12
  },
  "flowchart": {
    "padding": 18,
    "nodeSpacing": 40,
    "rankSpacing": 45,
    "subGraphTitleMargin": {
      "top": 6,
      "bottom": 14
    }
  }
}
